local SavedPosition = nil
local SavedCameraCFrame = nil

task.spawn(function()
    while task.wait(0.5) do
        local chestHRP, chestPrompt = nil, nil
        
        if AutoChestEnabled then
            chestHRP, chestPrompt = GetShipChest()
        end
        
        if not chestHRP and AutoChest2Enabled then
            chestHRP, chestPrompt = GetAbandonedChest()
        end
        
        if chestHRP and chestPrompt then
            local character = LocalPlayer.Character
            local hrp = character and character:FindFirstChild("HumanoidRootPart")
            local camera = workspace.CurrentCamera
            
            if hrp then
                -- Simpan CFrame sebelum teleportasi
                if not IsCollectingChest then
                    SavedPosition = hrp.CFrame
                    SavedCameraCFrame = camera.CFrame
                end
                
                IsCollectingChest = true 
                
                hrp.CFrame = chestHRP.CFrame + Vector3.new(0, 3, 0)
                hrp.Velocity = Vector3.new(0,0,0)
                
                chestPrompt.HoldDuration = 0
                if fireproximityprompt then
                    fireproximityprompt(chestPrompt)
                else
                    chestPrompt:InputHoldBegin()
                    task.wait(0.1)
                    chestPrompt:InputHoldEnd()
                end
                
                task.wait(1) 
            end
        else
            -- Kembalikan posisi jika chest selesai diambil
            if IsCollectingChest and SavedPosition then
                local character = LocalPlayer.Character
                local hrp = character and character:FindFirstChild("HumanoidRootPart")
                local camera = workspace.CurrentCamera
                
                if hrp then
                    hrp.CFrame = SavedPosition
                    hrp.Velocity = Vector3.new(0,0,0)
                    
                    if SavedCameraCFrame then
                        camera.CFrame = SavedCameraCFrame
                    end
                end
                
                SavedPosition = nil
                SavedCameraCFrame = nil
            end
            
            IsCollectingChest = false
        end
    end
end)

