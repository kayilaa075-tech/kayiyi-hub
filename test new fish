local function GetPlayerTools()
    local tools = {}
    if LocalPlayer:FindFirstChild("Backpack") then
        for _, item in pairs(LocalPlayer.Backpack:GetChildren()) do
            if item:IsA("Tool") then table.insert(tools, item.Name) end
        end
    end
    if LocalPlayer.Character then
        for _, item in pairs(LocalPlayer.Character:GetChildren()) do
            if item:IsA("Tool") then table.insert(tools, item.Name) end
        end
    end
    if #tools == 0 then table.insert(tools, "Tidak ada senjata") end
    return tools
end

-- EQUIP MENGGUNAKAN REMOTE (Tanpa pengecekan tas lokal)
local function EquipTool(ToolName, SlotNumber)
    if ToolName == "" or ToolName == "Tidak ada senjata" then return nil end
    local character = LocalPlayer.Character
    if not character then return nil end

    -- Cek jika sudah dipegang
    local currentTool = character:FindFirstChild(ToolName)
    if currentTool then return currentTool end
    
    -- Tembak Remote SetEquippedItem
    pcall(function()
        game:GetService("ReplicatedStorage").Shared.DataStreams.SetEquippedItem:InvokeServer(SlotNumber)
    end)
    task.wait(0.3) -- Jeda agar server merespons
    
    return character:FindFirstChild(ToolName)
end

local function SellEverything()
    pcall(function()
        game:GetService("ReplicatedStorage").Shared.DataStreams.processGameItemSold:InvokeServer("SellEverything")
    end)
end

local function GetClosestDrop()
    local drops = Workspace:FindFirstChild("DroppedItems")
    if drops then
        for _, item in pairs(drops:GetChildren()) do
            if item:IsA("BasePart") then return item
            elseif item:IsA("Model") then
                local part = item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")
                if part then return part end
            end
        end
    end
    return nil
end

local function GetClosestMob()
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local targetNeon, targetNormal = nil, nil
    local distNeon, distNormal = math.huge, math.huge

    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("Hitbox") and not obj:FindFirstChild("Humanoid") then
            local hitbox = obj:FindFirstChild("Hitbox")
            if not hitbox.Anchored or hitbox.AssemblyLinearVelocity.Magnitude > 0.5 then
                local distance = (hrp.Position - hitbox.Position).Magnitude
                local isNeon = false
                
                for _, part in pairs(obj:GetDescendants()) do
                    if part:IsA("BasePart") and part.Name ~= "Hitbox" and part.Material == Enum.Material.Neon then
                        isNeon = true
                        break 
                    end
                end
                
                if isNeon then
                    if distance < distNeon then distNeon = distance; targetNeon = hitbox end
                else
                    if distance < distNormal then distNormal = distance; targetNormal = hitbox end
                end
            end
        end
    end
    return targetNeon or targetNormal
end

local function GetShipChest()
    for _, obj in pairs(Workspace:GetChildren()) do
        if obj:IsA("Model") and string.find(obj.Name, "ShipModel") then
            for _, child in pairs(obj:GetChildren()) do
                if child:IsA("Model") and string.find(child.Name, "Chest_") then
                    local hrp = child:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local prompt = hrp:FindFirstChildWhichIsA("ProximityPrompt")
                        if prompt then return hrp, prompt end
                    end
                end
            end
        end
    end
    return nil, nil
end

local function GetAbandonedChest()
    for _, obj in pairs(Workspace:GetChildren()) do
        if obj:IsA("Model") and string.find(obj.Name, "AbandonedContainers") then
            for _, child in pairs(obj:GetChildren()) do
                if child:IsA("Model") and string.find(child.Name, "Chest_") then
                    local hrp = child:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local prompt = hrp:FindFirstChildWhichIsA("ProximityPrompt")
                        if prompt then return hrp, prompt end
                    end
                end
            end
        end
    end
    return nil, nil
end

