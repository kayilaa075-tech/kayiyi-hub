RunService.Heartbeat:Connect(function()
    if AutoKillEnabled and not IsCollectingChest then
        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChild("Humanoid")
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        
        if hrp and humanoid and humanoid.Health > 0 then
            if CurrentDrop and CurrentDrop.Parent then
                hrp.CFrame = CFrame.new(CurrentDrop.Position)
                hrp.Velocity = Vector3.new(0,0,0)
            elseif CurrentTarget and CurrentTarget.Parent then
                local targetPos = CurrentTarget.Position
                hrp.CFrame = CFrame.lookAt(targetPos + Vector3.new(0, 15, 35), targetPos)
                hrp.Velocity = Vector3.new(0,0,0) 
            end
        end
    end
end)

task.spawn(function()
    while task.wait() do
        if IsCollectingChest then task.wait(1); continue end

        if AutoKillEnabled then
            local character = LocalPlayer.Character
            local humanoid = character and character:FindFirstChild("Humanoid")
            local hrp = character and character:FindFirstChild("HumanoidRootPart")
            
            if character and humanoid and humanoid.Health > 0 and hrp then
                CurrentDrop = GetClosestDrop()
                if CurrentDrop then
                    CurrentTarget = nil
                    local waitTime = 0
                    while CurrentDrop and CurrentDrop.Parent and waitTime < 2.5 do
                        if IsCollectingChest then break end 
                        task.wait(0.1)
                        waitTime = waitTime + 0.1
                    end
                    if CurrentDrop and CurrentDrop.Parent and AutoSellEnabled and not IsCollectingChest then
                        SellEverything()
                        task.wait(1) 
                    end
                else
                    if not CurrentTarget or not CurrentTarget.Parent then
                        CurrentTarget = GetClosestMob()
                    end
                    if CurrentTarget then
                        -- Equip menggunakan Slot 2
                        local toolToUse = EquipTool(SelectedWeapon, 2)
                        if toolToUse then
                            local mobModel = CurrentTarget.Parent
                            
                            if mobModel then
                                pcall(function()
                                    local DataStreams = game:GetService("ReplicatedStorage").Shared.DataStreams
                                    
                                    if DataStreams:FindFirstChild("SpearThrown") then
                                        DataStreams.SpearThrown:FireServer(
                                            toolToUse.Name, 
                                            hrp.CFrame, 
                                            Vector3.new(0, 0, -1), 
                                            tick()
                                        )
                                    end
                                    
                                    if DataStreams:FindFirstChild("MonsterHit") then
                                        DataStreams.MonsterHit:FireServer(
                                            mobModel, 
                                            toolToUse.Name, 
                                            true
                                        )
                                    end
                                end)
                            end
                            task.wait(1.2) 
                        else
                            task.wait(0.5)
                        end
                    else
                        task.wait(1)
                    end
                end
            else
                CurrentTarget = nil
                CurrentDrop = nil
                task.wait(1)
            end
        else
            CurrentTarget = nil
            CurrentDrop = nil
            task.wait(0.5)
        end
    end
end)

-- ==========================================
-- LOOP 3: AUTO FISHING
-- ==========================================
task.spawn(function()
    while task.wait() do
        if IsCollectingChest then task.wait(1); continue end

        if AutoFishEnabled then
            local character = LocalPlayer.Character
            local humanoid = character and character:FindFirstChild("Humanoid")
            local hrp = character and character:FindFirstChild("HumanoidRootPart")
            
            if character and humanoid and humanoid.Health > 0 then
                local gui = LocalPlayer:FindFirstChild("PlayerGui")
                local interface = gui and gui:FindFirstChild("Interface")
                
                local isBackpackFull = false
                if interface then
                    local inventory = interface:FindFirstChild("Inventory")
                    local quickAccess = inventory and inventory:FindFirstChild("QuickAccess")
                    local backpackToggle = quickAccess and quickAccess:FindFirstChild("BackpackToggle")
                    local inventoryCapacity = backpackToggle and backpackToggle:FindFirstChild("InventoryCapacity")
                    
                    if inventoryCapacity and inventoryCapacity:IsA("TextLabel") then
                        local current, max = string.match(inventoryCapacity.Text, "(%d+)/(%d+)")
                        if current and max then
                            if tonumber(current) >= tonumber(max) then
                                isBackpackFull = true
                            end
                        end
                    end
                end
                
                if isBackpackFull and AutoSellEnabled then
                    -- Unequip via Remote sebelum sell
                    local currentTool = character:FindFirstChildWhichIsA("Tool")
                    if currentTool then
                        pcall(function()
                            game:GetService("ReplicatedStorage").Shared.DataStreams.UnequipTool:InvokeServer(currentTool)
                        end)
                        task.wait(0.2)
                    end

                    SellEverything()
                    task.wait(1.5) 
                    continue 
                end

                -- Equip menggunakan Slot 1
                local rod = EquipTool(SelectedRod, 1)
                if not rod then 
                    task.wait(1) 
                    continue 
                end

                local bobber = rod:FindFirstChild("Bobber")
                local fishingUI = interface and interface:FindFirstChild("Fishing")
                local fishingMeter = fishingUI and fishingUI:FindFirstChild("FishingMeter")

                if fishingMeter and fishingMeter.Visible then
                    local mover = fishingMeter:FindFirstChild("Mover")

                    if mover then
                        local moverPos = mover.Position.X.Scale
                        if moverPos < 0.45 then
                            local viewportSize = workspace.CurrentCamera.ViewportSize
                            VirtualUser:ClickButton1(Vector2.new(viewportSize.X / 2, viewportSize.Y / 2))
                            task.wait(0.05) 
                        else
                            task.wait(0.2) 
                        end
                    end
                    continue
                end

                if bobber then
                    local hookedFish = bobber:FindFirstChild("HookedFish")
                    
                    if hookedFish and hookedFish.Value ~= nil then
                        local currentFishName = ""
                        if typeof(hookedFish.Value) == "Instance" then
                            currentFishName = hookedFish.Value.Name
                        else
                            currentFishName = tostring(hookedFish.Value)
                        end
                        
                        local shouldCatch = true
                        
                        if FishFilterEnabled and #TargetFishList > 0 then
                            shouldCatch = false
                            local lowerCurrentFish = string.lower(currentFishName)
                            
                            for _, targetFish in ipairs(TargetFishList) do
                                if string.find(lowerCurrentFish, string.lower(targetFish)) then
                                    shouldCatch = true
                                    break
                                end
                            end
                        end
                        
                        if shouldCatch then
                            rod:Activate()
                            local viewportSize = workspace.CurrentCamera.ViewportSize
                            VirtualUser:ClickButton1(Vector2.new(viewportSize.X / 2, viewportSize.Y / 2))
                            task.wait(1) 
                        else
                            task.wait(0.5)
                        end
                        
                    else
                        local dist = hrp and (bobber.Position - hrp.Position).Magnitude or 15
                        if dist < 10 then
                            rod:Activate()
                            local viewportSize = workspace.CurrentCamera.ViewportSize
                            VirtualUser:ClickButton1(Vector2.new(viewportSize.X / 2, viewportSize.Y / 2))
                            task.wait(2.5) 
                        else
                            task.wait(0.1)
                        end
                    end
                else
                    rod:Activate()
                    local viewportSize = workspace.CurrentCamera.ViewportSize
                    VirtualUser:ClickButton1(Vector2.new(viewportSize.X / 2, viewportSize.Y / 2))
                    task.wait(1.5)
                end
            else
                task.wait(1) 
            end
        else
            task.wait(0.5)
        end
    end
end)
